rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      // Замените на email администраторов (те же, что добавите в Authentication → Users)
      allow read, write: if request.auth != null
        && request.auth.token.email in [
          "admin1@example.com",
          "admin2@example.com"
        ];
    }
  }
}
